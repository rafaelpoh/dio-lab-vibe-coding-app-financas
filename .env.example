# ==============================================================================
# CONFIGURAÇÕES DO FIREBASE (CLIENTE / FRONTEND)
# Obtenha estas credenciais no Firebase Console > Configurações do Projeto > Seus aplicativos
# ==============================================================================
VITE_FIREBASE_API_KEY="seu_firebase_api_key_aqui"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="seu_messaging_sender_id"
VITE_FIREBASE_APP_ID="seu_firebase_app_id"

# ==============================================================================
# CONFIGURAÇÕES DO FIREBASE ADMIN (BACKEND / SERVERLESS FUNCTIONS)
# Localmente: caminho para a chave JSON de conta de serviço (serviceAccountKey.json)
# Na Vercel (Produção): defina a variável FIREBASE_SERVICE_ACCOUNT com o conteúdo JSON bruto
# ==============================================================================
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"

# ==============================================================================
# INTELIGÊNCIA ARTIFICIAL (GOOGLE GEMINI API)
# Obtenha sua chave gratuita no Google AI Studio: https://aistudio.google.com/
# ==============================================================================
GEMINI_API_KEY="sua_gemini_api_key_aqui"
